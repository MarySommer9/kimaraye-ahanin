{
  "name": "kimaraye-ahanin",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kimaraye-ahanin-db",
      "database_id": "YOUR_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "YOUR_KV_ID"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
